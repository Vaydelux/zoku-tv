<!-- Vanilla JS micro-interactions -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
      // Toggle sound button micro-interaction
      const soundBtn = document.querySelector('[data-icon="volume_up"]');
      if (soundBtn) {
        soundBtn.addEventListener('click', () => {
          const iconSpan = soundBtn.querySelector('.material-symbols-outlined');
          if (iconSpan.textContent.trim() === 'volume_up') {
            iconSpan.textContent = 'volume_off';
            soundBtn.classList.add('text-primary');
          } else {
            iconSpan.textContent = 'volume_up';
            soundBtn.classList.remove('text-primary');
          }
        });
      }

      // Add to list feedback
      const addListBtn = document.querySelector('[data-icon="add"]');
      if (addListBtn) {
        addListBtn.addEventListener('click', () => {
          const iconSpan = addListBtn.querySelector('.material-symbols-outlined');
          if (iconSpan.textContent.trim() === 'add') {
            iconSpan.textContent = 'check';
            addListBtn.classList.add('bg-primary-container', 'text-white');
          } else {
            iconSpan.textContent = 'add';
            addListBtn.classList.remove('bg-primary-container', 'text-white');
          }
        });
      }
    });
  </script>
