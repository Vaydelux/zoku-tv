NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Server-side TMDB API Read Access Token. Never set NEXT_PUBLIC_TMDB_*.
TMDB_API_READ_ACCESS_TOKEN=
# Server-only secret, never prefix with NEXT_PUBLIC_. Use 12+ characters.
ADULT_CONTENT_PASSWORD=
# Optional 32+ char secret to sign adult unlock sessions.
ADULT_CONTENT_SESSION_SECRET=
# Optional comma-separated manual blocklist (public client-side heuristic).
NEXT_PUBLIC_BLOCKED_TMDB_MOVIE_IDS=

# Optional server-only comma-separated AniList anime IDs to block even if AniList metadata is incomplete.
BLOCKED_ANILIST_ANIME_IDS=
