rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // On UPDATE, validate the fields modified by this request, NOT every
    // historical field still present in request.resource.data. Legacy profiles
    // may contain values from older application versions (for example a
    // previous appearance setting); unrelated edits must remain possible.
    // On CREATE, all supplied fields remain subject to validation.
    function validProfileFields(data, changedKeys) {
      return (!changedKeys.hasAny(['name']) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 15))
        && (!changedKeys.hasAny(['avatar']) || data.avatar is string)
        && (!changedKeys.hasAny(['avatarColor']) || data.avatarColor is string)
        && (!changedKeys.hasAny(['kidMode']) || data.kidMode is bool)
        && (!changedKeys.hasAny(['themePreference']) || data.themePreference is string)
        && (!changedKeys.hasAny(['appearancePreference']) || data.appearancePreference in ['dark', 'light'])
        && (!changedKeys.hasAny(['iframeModePreference']) || data.iframeModePreference in ['Strict', 'Compatibility'])
        && (!changedKeys.hasAny(['catalogMode']) || data.catalogMode in ['tmdb', 'anime'])
        && (!changedKeys.hasAny(['homeGenreRailPreferences'])
          || (data.homeGenreRailPreferences is list && data.homeGenreRailPreferences.size() <= 50))
        && (!changedKeys.hasAny(['createdAt']) || data.createdAt is string)
        && (!changedKeys.hasAny(['updatedAt']) || data.updatedAt is string);
    }

    function validProfileCreate() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'name', 'kidMode', 'themePreference', 'iframeModePreference', 'homeGenreRailPreferences'
        ])
        && validProfileFields(data, data.keys());
    }

    function validProfileUpdate() {
      let data = request.resource.data;
      let changedKeys = data.diff(resource.data).affectedKeys();
      return validProfileFields(data, changedKeys);
    }

    function validWatchlistItem() {
      let data = request.resource.data;
      return data.keys().hasAll(['media_type', 'added_at'])
        && data.media_type in ['movie', 'tv', 'anime']
        && data.added_at is string
        && (
          (data.media_type == 'anime' && data.keys().hasAll(['anilistId']) && data.anilistId is int)
          || (data.media_type in ['movie', 'tv'] && data.keys().hasAll(['tmdbId']) && data.tmdbId is int)
        )
        && (!('title' in data) || data.title is string)
        && (!('poster_path' in data) || data.poster_path == null || data.poster_path is string)
        && (!('backdrop_path' in data) || data.backdrop_path == null || data.backdrop_path is string)
        && (!('vote_average' in data) || data.vote_average is number)
        && (!('release_date' in data) || data.release_date == null || data.release_date is string)
        && (!('creator' in data) || data.creator == null || data.creator is string)
        && (!('genres' in data) || data.genres == null || (data.genres is list && data.genres.size() <= 15));
    }

    function validSearchHistory() {
      let data = request.resource.data;
      return data.history is list
        && data.history.size() <= 10
        && (data.keys().hasOnly(['history'])
          || (data.keys().hasOnly(['history', 'updatedAt']) && data.updatedAt is string));
    }

    function validContinueWatchingItem() {
      let data = request.resource.data;
      return data.keys().hasAll(['media_type', 'title', 'last_watched_at'])
        && data.media_type in ['movie', 'tv', 'anime']
        && data.title is string
        && data.last_watched_at is string
        && (
          (data.media_type == 'anime' && 'anilistId' in data && data.anilistId is int)
          || (data.media_type in ['movie', 'tv'] && 'tmdbId' in data && data.tmdbId is int)
        )
        && (!('season' in data) || data.season == null || data.season is int)
        && (!('episode' in data) || data.episode == null || data.episode is int)
        && (!('poster_path' in data) || data.poster_path == null || data.poster_path is string)
        && (!('backdrop_path' in data) || data.backdrop_path == null || data.backdrop_path is string)
        && (!('progress_percent' in data) || data.progress_percent == null
          || (data.progress_percent is number && data.progress_percent >= 0 && data.progress_percent <= 100))
        && (!('current_time_sec' in data) || data.current_time_sec == null || data.current_time_sec is number)
        && (!('duration_sec' in data) || data.duration_sec == null || data.duration_sec is number);
    }

    function validWatchHistoryItem() {
      let data = request.resource.data;
      return data.keys().hasAll(['media_type', 'title', 'watched_at'])
        && data.media_type in ['movie', 'tv', 'anime']
        && data.title is string
        && data.watched_at is string
        && (
          (data.media_type == 'anime' && 'anilistId' in data && data.anilistId is int)
          || (data.media_type in ['movie', 'tv'] && 'tmdbId' in data && data.tmdbId is int)
        )
        && (!('season' in data) || data.season == null || data.season is int)
        && (!('episode' in data) || data.episode == null || data.episode is int)
        && (!('poster_path' in data) || data.poster_path == null || data.poster_path is string)
        && (!('backdrop_path' in data) || data.backdrop_path == null || data.backdrop_path is string);
    }

    function validEpisodeProgressItem() {
      let data = request.resource.data;
      return data.keys().hasAll(['media_type', 'season', 'episode', 'status', 'updated_at'])
        && data.media_type in ['tv', 'anime']
        && data.season is int && data.season >= 1
        && data.episode is int && data.episode >= 1
        && data.status in ['in_progress', 'completed']
        && data.updated_at is string;
    }

    match /users/{userId} {
      allow read, write: if false;

      match /profiles/{profileId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validProfileCreate();
        allow update: if isOwner(userId) && validProfileUpdate();
        allow delete: if isOwner(userId);

        match /watchlist/{entryKey} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && validWatchlistItem();
          allow delete: if isOwner(userId);
        }

        match /searchHistory/{docId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && validSearchHistory();
          allow delete: if isOwner(userId);
        }

        match /continueWatching/{entryKey} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && validContinueWatchingItem();
          allow delete: if isOwner(userId);
        }

        match /watchHistory/{entryKey} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && validWatchHistoryItem();
          allow delete: if isOwner(userId);
        }

        match /episodeProgress/{entryKey} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId) && validEpisodeProgressItem();
          allow delete: if isOwner(userId);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
